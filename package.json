{
  "name": "web-automation-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Resilient Web Automation Lab — sandbox site + Playwright bot. Visual CAPTCHA, checkpoint/resume, 10 scenarios, observability.",
  "scripts": {
    "site": "node scripts/start-site.js",
    "site:off": "node scripts/start-site.js --preset off",
    "site:slow": "node scripts/start-site.js --preset slow",
    "site:drift": "node scripts/start-site.js --preset drift",
    "site:blocked": "node scripts/start-site.js --preset blocked",
    "site:all": "node scripts/start-site.js --preset all",
    "bot": "node bot/run.js",
    "bot:demo": "node bot/run.js --headed --limit 3",
    "bot:watch": "node scripts/run-bot.js --headed --limit 3",
    "demo:all": "node scripts/demo-all.js",
    "demo:all:watch": "node scripts/demo-all.js --watch",
    "demo:quick": "node scripts/demo-all.js --headed --watch --limit 2",
    "test": "playwright test",
    "test:unit": "playwright test \"tests/test_unit_week2.spec.js\" \"tests/test_unit_week3.spec.js\"",
    "test:e2e": "playwright test \"tests/test_happy_path.spec.js\" \"tests/test_scenarios_week2.spec.js\" \"tests/test_scenarios_week3.spec.js\" \"tests/test_week4.spec.js\" \"tests/test_demo_mode.spec.js\" \"tests/test_all_four.spec.js\" \"tests/test_gauntlet.spec.js\"",
    "test:happy": "playwright test tests/test_happy_path.spec.js",
    "test:scenarios": "playwright test tests/test_scenarios_week*.spec.js",
    "test:gauntlet": "playwright test tests/test_gauntlet.spec.js",
    "lint": "eslint bot/ tests/ scripts/ playwright.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "verify": "npm run quality && npm run test:unit && npm run test:e2e",
    "setup": "node scripts/setup.js",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
